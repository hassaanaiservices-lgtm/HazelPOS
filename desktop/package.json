{
  "name": "hazelpos-desktop",
  "productName": "HazelPOS",
  "version": "1.0.0",
  "description": "HazelPOS restaurant point of sale",
  "author": "HazelPOS",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prepare-app": "npm --prefix ../client ci && npm --prefix ../client run build && npm --prefix ../server ci --omit=dev",
    "dist": "npm run prepare-app && electron-builder",
    "dist:win": "npm run prepare-app && electron-builder --win",
    "dist:mac": "npm run prepare-app && electron-builder --mac",
    "dist:linux": "npm run prepare-app && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hazelpos.desktop",
    "productName": "HazelPOS",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "extraResources": [
      { "from": "../server", "to": "app/server", "filter": ["**/*", "!pos.db*", "!*.db*", "!whatsapp/auth/**", "!whatsapp/media/**"] },
      { "from": "../server/node_modules", "to": "app/server/node_modules", "filter": ["**/*"] },
      { "from": "../client/dist", "to": "app/client/dist" },
      { "from": "../rag", "to": "app/rag", "filter": ["**/*", "!eval/**", "!data/index/**", "!scripts/**"] },
      { "from": "../brand/hazelpos-logo/hazelpos-logo.png", "to": "icon.png" }
    ],
    "icon": "../brand/hazelpos-logo/hazelpos-logo.png",
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "HazelPOS"
    },
    "mac": { "target": "dmg", "category": "public.app-category.business" },
    "linux": { "target": "AppImage", "category": "Office" },
    "publish": [{ "provider": "github", "owner": "hassaanaiservices-lgtm", "repo": "HazelPOS" }]
  }
}
