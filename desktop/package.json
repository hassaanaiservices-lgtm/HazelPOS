{
  "name": "hazelpos-printer",
  "productName": "HazelPOS Printer",
  "version": "1.0.8",
  "description": "HazelPOS Printer: prints HazelPOS receipts and kitchen tickets on this PC's printers",
  "author": "HazelPOS",
  "private": true,
  "main": "main.js",
  "hazel": {
    "serverUrl": "https://pos2.up.railway.app"
  },
  "scripts": {
    "start": "electron .",
    "verify": "node verify-build.js",
    "dist": "node verify-build.js pre && electron-builder --win --publish never && node verify-build.js post"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.hazelpos.printer",
    "productName": "HazelPOS Printer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "scan.js",
      "window/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../bridge",
        "to": "app/bridge",
        "filter": [
          "bridge.js"
        ]
      },
      {
        "from": "../server/printer.js",
        "to": "app/server/printer.js"
      },
      {
        "from": "../brand/hazelpos-logo/hazelpos-logo.png",
        "to": "icon.png"
      }
    ],
    "icon": "../brand/hazelpos-logo/hazelpos-logo.png",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "HazelPOS Printer",
      "artifactName": "HazelPOS-Printer-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hassaanaiservices-lgtm",
        "repo": "-HazelPOS-releases",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ]
  }
}
