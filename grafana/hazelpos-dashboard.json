    {
      "id": 11,
      "type": "timeseries",
      "title": "AI cost this month by branch (USD)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hazel_branch_ai_cost_month_usd",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "legendFormat": "{{client}} / {{branch}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
